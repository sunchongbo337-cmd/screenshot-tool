{
  "manifest_version": 3,
  "name": "ScreenShot (Alt+Shift+A)",
  "version": "0.1.12",
  "description": "Alt+Shift+A region screenshot — https pages + new-tab/search fallback.",
  "action": {
    "default_title": "ScreenShot — Alt+Shift+A region capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "tabs", "scripting", "clipboardWrite", "desktopCapture"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Region screenshot (js-web-screen-shot)"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
